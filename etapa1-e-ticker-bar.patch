diff --git a/supabase/migrations/0022_watchlist_tickers.sql b/supabase/migrations/0022_watchlist_tickers.sql
new file mode 100644
index 0000000..d112385
--- /dev/null
+++ b/supabase/migrations/0022_watchlist_tickers.sql
@@ -0,0 +1,41 @@
+-- ============================================================
+-- OptionOS — Migration 0022
+-- Faixa de cotações do topo do Dashboard: lista de ativos que o
+-- usuário cadastra manualmente para acompanhar, independente de
+-- ter operação aberta neles (diferente da tabela assets, que só
+-- ganha uma linha quando existe operação).
+--
+-- Criada nos dois schemas (diogo e mae) porque cada perfil tem
+-- sua própria lista de acompanhamento.
+-- ============================================================
+
+create table diogo.watchlist_tickers (
+  id uuid primary key default gen_random_uuid(),
+  ticker text not null unique,
+  sort_order integer not null default 0,
+  created_at timestamptz not null default now()
+);
+
+alter table diogo.watchlist_tickers enable row level security;
+create policy "allow all - watchlist_tickers" on diogo.watchlist_tickers for all using (true) with check (true);
+grant all on diogo.watchlist_tickers to anon, authenticated, service_role;
+
+create table mae.watchlist_tickers (
+  id uuid primary key default gen_random_uuid(),
+  ticker text not null unique,
+  sort_order integer not null default 0,
+  created_at timestamptz not null default now()
+);
+
+alter table mae.watchlist_tickers enable row level security;
+create policy "allow all - watchlist_tickers" on mae.watchlist_tickers for all using (true) with check (true);
+grant all on mae.watchlist_tickers to anon, authenticated, service_role;
+
+-- Semeia a lista do Diogo com os ativos que ele já opera hoje —
+-- assim a faixa não começa vazia. A do Mãe fica vazia mesmo
+-- (ele ainda não tem operações), pra ser cadastrada na mão.
+insert into diogo.watchlist_tickers (ticker, sort_order)
+select ticker, row_number() over (order by ticker) - 1
+from diogo.assets
+where active = true
+on conflict (ticker) do nothing;
